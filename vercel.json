{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/telegram-webhook"
    },
    {
      "source": "/api/telegram/setup",
      "destination": "/api/telegram-webhook"
    },
    {
      "source": "/api/auth/telegram-start",
      "destination": "/api/auth/telegram?action=start"
    },
    {
      "source": "/api/auth/telegram-status",
      "destination": "/api/auth/telegram?action=status"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/session?action=me"
    },
    {
      "source": "/api/auth/providers",
      "destination": "/api/auth/session?action=providers"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth/session?action=login"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/session?action=register"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/session?action=logout"
    },
    {
      "source": "/api/notifications/settings",
      "destination": "/api/notifications?action=settings"
    },
    {
      "source": "/api/notifications/telegram-link",
      "destination": "/api/notifications?action=telegram-link"
    },
    {
      "source": "/api/notifications/telegram-unlink",
      "destination": "/api/notifications?action=telegram-unlink"
    },
    {
      "source": "/api/notifications/admin-alert",
      "destination": "/api/notifications?action=admin-alert"
    },
    {
      "source": "/api/cron/daily-reminder",
      "destination": "/api/notifications?action=cron-daily-reminder"
    },
    {
      "source": "/((?!api/|assets/|audio/|images/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 14 * * *"
    }
  ]
}
