    "text": "Ajoyib! Juda chiroyli o‘qiding!"
  },
  "praise_4.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Yasha! Xuddi shunday davom et!"
  },
  "praise_round_complete.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Ura! Mashqni a’lo darajada yakunlading! Juda ko‘p yulduzcha to‘plading, barakalla!"
  },
  "praise_alphabet_complete.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Ofarin! Barcha harflarni zo‘r takrorlading! Sen haqiqiy chempionsan!"
  },
  "barakalla.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Barakalla bolajon! Juda chiroyli va to‘g‘ri o‘qiding!"
  },
  "qayta_urinib_koring.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Hechqisi yo‘q! Keling, yana bir marta birga urinib ko‘ramiz!"
  },
  "qaysi_biri.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Diqqat bilan quloq sol va to‘g‘ri kartani bos!"
  },
  "ulab_oqiymiz.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Endi vagonchalarni birlashtirib, harflarni ulab o‘qi!"
  },
  "mikrofonga_ayting.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Mikrofon tugmasini bosib, baland ovozda o‘qib ber!"
  },
  "jimlik_sezildi.mp3": {
    "provider": "voicelab",
    "voice": "lison-v2:malika",
    "text": "Ovozing yaxshi eshitilmadi, mikrofon yonida balandroq ayt!"
  },
